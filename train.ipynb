# ==============================================
# 胸部X光肺炎二分类实战 - 完整代码
# 运行环境：Kaggle Notebook / Google Colab
# ==============================================
import os
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.metrics import classification_report, confusion_matrix
import tensorflow as tf
from tensorflow.keras.preprocessing.image import ImageDataGenerator
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Conv2D, MaxPooling2D, Flatten, Dense, Dropout, BatchNormalization
from tensorflow.keras.optimizers import Adam

# 固定随机种子，保证结果可复现
np.random.seed(42)
tf.random.set_seed(42)

# ===================== 1. 路径与参数设置 =====================
# Kaggle 数据集路径（直接挂载无需下载）
BASE_PATH = '/kaggle/input/chest-xray-pneumonia/chest_xray/'
TRAIN_PATH = os.path.join(BASE_PATH, 'train')
TEST_PATH = os.path.join(BASE_PATH, 'test')

# 超参数
IMG_SIZE = (150, 150)
BATCH_SIZE = 32
EPOCHS = 20
LEARNING_RATE = 0.001

# ===================== 2. 数据集统计 =====================
def count_images(folder_path):
    normal = len(os.listdir(os.path.join(folder_path, 'NORMAL')))
    pneumonia = len(os.listdir(os.path.join(folder_path, 'PNEUMONIA')))
    return normal, pneumonia, normal + pneumonia

train_normal, train_pneu, train_total = count_images(TRAIN_PATH)
test_normal, test_pneu, test_total = count_images(TEST_PATH)

print("===== 数据集样本统计 =====")
print(f"训练集：正常={train_normal}, 肺炎={train_pneu}, 总计={train_total}")
print(f"测试集：正常={test_normal}, 肺炎={test_pneu}, 总计={test_total}")

# ===================== 3. 数据加载与增强 =====================
# 训练集：增强 + 划分验证集（8:2）
train_datagen = ImageDataGenerator(
    rescale=1./255,
    rotation_range=10,
    width_shift_range=0.1,
    height_shift_range=0.1,
    horizontal_flip=True,
    zoom_range=0.1,
    validation_split=0.2
)

# 测试集：仅归一化
test_datagen = ImageDataGenerator(rescale=1./255)

# 生成迭代器
train_gen = train_datagen.flow_from_directory(
    TRAIN_PATH, target_size=IMG_SIZE, batch_size=BATCH_SIZE,
    class_mode='binary', subset='training', shuffle=True
)

val_gen = train_datagen.flow_from_directory(
    TRAIN_PATH, target_size=IMG_SIZE, batch_size=BATCH_SIZE,
    class_mode='binary', subset='validation', shuffle=False
)

test_gen = test_datagen.flow_from_directory(
    TEST_PATH, target_size=IMG_SIZE, batch_size=BATCH_SIZE,
    class_mode='binary', shuffle=False
)

# ===================== 4. 搭建CNN模型 =====================
model = Sequential([
    Conv2D(32, (3,3), activation='relu', input_shape=(*IMG_SIZE, 3)),
    BatchNormalization(), MaxPooling2D((2,2)), Dropout(0.25),

    Conv2D(64, (3,3), activation='relu'),
    BatchNormalization(), MaxPooling2D((2,2)), Dropout(0.25),

    Conv2D(128, (3,3), activation='relu'),
    BatchNormalization(), MaxPooling2D((2,2)), Dropout(0.25),

    Conv2D(256, (3,3), activation='relu'),
    BatchNormalization(), MaxPooling2D((2,2)), Dropout(0.25),

    Flatten(),
    Dense(512, activation='relu'), BatchNormalization(), Dropout(0.5),
    Dense(1, activation='sigmoid')
])

# 编译模型
model.compile(
    optimizer=Adam(learning_rate=LEARNING_RATE),
    loss='binary_crossentropy',
    metrics=['accuracy', tf.keras.metrics.Precision(), tf.keras.metrics.Recall()]
)

model.summary()

# ===================== 5. 模型训练 =====================
history = model.fit(
    train_gen,
    validation_data=val_gen,
    epochs=EPOCHS,
    steps_per_epoch=train_gen.samples // BATCH_SIZE,
    validation_steps=val_gen.samples // BATCH_SIZE
)

# ===================== 6. 模型评估 =====================
test_loss, test_acc, test_prec, test_recall = model.evaluate(test_gen)
test_f1 = 2 * (test_prec * test_recall) / (test_prec + test_recall)

print("\n===== 测试集最终指标 =====")
print(f"准确率(Accuracy): {test_acc:.4f}")
print(f"精确率(Precision): {test_prec:.4f}")
print(f"召回率(Recall): {test_recall:.4f}")
print(f"F1分数: {test_f1:.4f}")

# 预测结果
y_true = test_gen.classes
y_pred = (model.predict(test_gen) > 0.5).astype(int).flatten()

# ===================== 7. 保存图表 =====================
os.makedirs('figures', exist_ok=True)

# 1. 训练曲线
plt.figure(figsize=(12,4))
plt.subplot(121)
plt.plot(history.history['accuracy'], label='Train Acc')
plt.plot(history.history['val_accuracy'], label='Val Acc')
plt.title('Accuracy Curve')
plt.legend()

plt.subplot(122)
plt.plot(history.history['loss'], label='Train Loss')
plt.plot(history.history['val_loss'], label='Val Loss')
plt.title('Loss Curve')
plt.legend()
plt.savefig('figures/train_curve.png', dpi=300, bbox_inches='tight')
plt.close()

# 2. 混淆矩阵
cm = confusion_matrix(y_true, y_pred)
plt.figure(figsize=(7,5))
sns.heatmap(cm, annot=True, fmt='d', cmap='Blues',
            xticklabels=['Normal','Pneumonia'],
            yticklabels=['Normal','Pneumonia'])
plt.xlabel('Predicted')
plt.ylabel('True')
plt.title('Confusion Matrix')
plt.savefig('figures/confusion_matrix.png', dpi=300, bbox_inches='tight')
plt.close()

# 保存模型
model.save('pneumonia_model.h5')
print("\n模型与图表已保存完成！")
